{
  "name": "@aitrack/server",
  "version": "0.1.0",
  "private": true,
  "description": "Local server of AI Tracking System: project registry, event log, report API and report inbox.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "aitrack": "./dist/cli.js"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/cli.js --banner:js=\"#!/usr/bin/env node\"",
    "dev": "tsx watch src/cli.ts serve"
  },
  "dependencies": {
    "@aitrack/core": "0.1.0"
  }
}
